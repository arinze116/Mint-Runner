# =====================================================================
# Mint Command Bot — standalone repo (.env.example)
# Dedicated Telegram bot + Railway project + RPC for manual/scheduled mints.
# =====================================================================

BOT_ROLE=mint
MINT_BOT_ENABLED=true

# ---- Telegram ----
MINT_BOT_TOKEN=
PERSONAL_ID=
GROUP_ID=

# ---- Persistence ----
MONGODB_URI=

# ---- Wallets ----
MNEMONIC=
IMPORTED_KEYS=

# ---- Active chain -------------------------------------------------------
# Which chain the bot executes on.
#   1       = Ethereum Mainnet (default)
#   57073   = Ink (Kraken OP-Stack L2)
#   2000    = Robinhood Chain  (or whatever ROBINHOOD_CHAIN_ID is set to)
CHAIN_ID=1

# Override chain IDs if the defaults ever change
# ROBINHOOD_CHAIN_ID=2000
# INK_CHAIN_ID=57073

# ---- RPC — Ethereum (primary) ------------------------------------------
PROVIDER_URL=https://your-eth-rpc.example/v2/KEY
EXECUTION_RPC_URL=
BACKUP_RPC_URLS=
TRACKER_RPC_URL=
WS_RPC_URL=
TRACKER_WS_RPC_URL=

# ---- RPC — Ink Chain (CHAIN_ID=57073) -----------------------------------
# Public Ink RPC: https://rpc-gel.inkonchain.com
INK_RPC_URL=
INK_EXECUTION_RPC_URL=

# ---- RPC — Robinhood Chain (CHAIN_ID=2000) ------------------------------
ROBINHOOD_RPC_URL=
ROBINHOOD_EXECUTION_RPC_URL=

# ---- Detection ---------------------------------------------------------
ENABLE_PENDING_DETECTION=false
ENABLE_BLOCK_FALLBACK=true

# ---- RPC tuning --------------------------------------------------------
RPC_FAILOVER_ENABLED=true
RPC_TIMEOUT_MS=8000
EXECUTION_CONCURRENCY=4

# ---- HTTP / dashboard --------------------------------------------------
PORT=3000
API_SECRET=
NODE_ENV=production

# ---- Inclusion / gas ---------------------------------------------------
BUILDER_MINT_ENABLED=false
# INCLUSION_MODE=public

# ---- Contract mint -----------------------------------------------------
CONTRACT_MINT_ENABLED=true
SIMULATION_REQUIRED=true
# SKIP_PIPELINE_SIM=false
MAX_MINT_VALUE_ETH=0.05
MAX_GAS_LIMIT=500000
MAX_FEE_GWEI=80
MAX_PRIORITY_FEE_GWEI=5

# TELEGRAM_WEBHOOK_MODE=true
# TELEGRAM_WEBHOOK_BASE_URL=https://your-mint-service.up.railway.app
